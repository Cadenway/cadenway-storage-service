{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Patch, pin and digest updates merge on their own once CI is green.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Group updates to Cadenway packages.",
      "matchPackageNames": ["@cadenway/**"],
      "groupName": "cadenway packages"
    },
    {
      "description": "The AWS SDK packages are released together and move as one update.",
      "matchPackageNames": ["@aws-sdk/**"],
      "groupName": "aws sdk"
    },
    {
      "description": "TypeScript stays on 6.0 until the Nest CLI and typescript-eslint accept a newer line.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    }
  ]
}
